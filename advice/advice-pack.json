{
  // RigScope advice pack. Paths and condition syntax: see src/RigScope.Core/Rules/SnapshotQuery.cs.
  // Every rule must say how strong its evidence is. Prefer measured sources; say so when there are none.
  "version": "2026.10.30",
  "updated": "2026-10-30",
  "rules": [

    // ───────────────────────────── Display ─────────────────────────────
    {
      "id": "display.refresh-primary",
      "title": "Main monitor refresh rate",
      "category": "display",
      "appliesWhen": { "path": "display.maxRefreshHz", "gt": 0 },
      "current": "{display.refreshHz} Hz (max {display.maxRefreshHz} Hz) on {display.monitorName|default:your main monitor}",
      "outcomes": [
        { "when": { "path": "display.runningBelowMaxRefresh", "eq": true }, "status": "warn",
          "summary": "Your main monitor runs at {display.refreshHz} Hz but supports {display.maxRefreshHz} Hz." },
        { "status": "good", "summary": "Running at its highest refresh rate ({display.refreshHz} Hz)." }
      ],
      "recommendation": "Run your gaming monitor at its highest refresh rate.",
      "why": "A higher refresh rate shows each new frame sooner and makes motion clearer. Windows often picks 60 Hz for a new monitor, and the setting can reset after driver installs or cable changes.",
      "impact": "large",
      "evidence": "high",
      "steps": [
        "Open Settings › System › Display › Advanced display.",
        "Select the monitor and pick the highest refresh rate.",
        "If the rate you expect is missing, check the cable (DisplayPort, or HDMI 2.0 or newer) and the monitor's own menu for an overclock setting."
      ],
      "undo": "Pick the previous refresh rate in the same menu.",
      "risk": "None."
    },
    {
      "id": "display.refresh-secondary",
      "title": "Second monitor refresh rate",
      "category": "display",
      "appliesWhen": { "path": "displays[isPrimary=false]", "countGte": 1 },
      "current": "{displays[isPrimary=false].monitorName|join}: {displays[isPrimary=false].refreshHz|join} Hz",
      "outcomes": [
        { "when": { "path": "displays[isPrimary=false,runningBelowMaxRefresh=true]", "countGte": 1 }, "status": "suggest",
          "summary": "{displays[isPrimary=false,runningBelowMaxRefresh=true].monitorName|join} runs below its maximum ({displays[isPrimary=false,runningBelowMaxRefresh=true].maxRefreshHz|join} Hz)." },
        { "status": "good", "summary": "Your other monitors run at their highest refresh rate." }
      ],
      "recommendation": "Run every monitor at its highest refresh rate, and keep video and animated apps off the second screen while you play.",
      "why": "In exclusive fullscreen a second monitor at a different refresh rate is mostly harmless on Windows 11. People who see stutter usually trace it to videos, streams or animated wallpapers playing on the second screen, or to borderless mode. The evidence is forum reports, not measurements.",
      "impact": "small",
      "evidence": "low",
      "steps": [
        "Settings › System › Display › Advanced display › select the second monitor › pick its highest refresh rate.",
        "To test whether it matters on your PC: log frame times (CapFrameX or PresentMon) with the second monitor on and then unplugged, on the same map."
      ],
      "undo": "Pick the previous refresh rate.",
      "risk": "None."
    },
    {
      "id": "display.sync-choice",
      "title": "G-SYNC / FreeSync or uncapped with tearing",
      "category": "display",
      "kind": "preference",
      "outcomes": [ { "status": "info", "summary": "Two good setups; pick one and set your frame cap to match." } ],
      "recommendation": "Either: variable refresh (G-SYNC/FreeSync) on, V-Sync on in the driver, V-Sync off in the game, Reflex or Anti-Lag on. Or: everything off and as many FPS as you can hold, accepting tearing.",
      "why": "With variable refresh and Reflex, the frame rate is capped just under your refresh rate (about 158 FPS on 165 Hz), so you get no tearing and low latency. Uncapped without sync gives slightly lower latency at very high FPS, but the image tears. Most pros run uncapped; many players prefer the smoother picture. Neither is wrong.",
      "impact": "medium",
      "evidence": "high",
      "steps": [
        "Variable refresh: turn on Adaptive-Sync/FreeSync in the monitor's menu, then G-SYNC in NVIDIA Control Panel › Set up G-SYNC (or FreeSync in AMD Software).",
        "In NVIDIA Control Panel › Manage 3D settings, set Vertical sync to On. In the game, set V-Sync off and Reflex on.",
        "Uncapped: leave G-SYNC off, V-Sync off everywhere, and set the game's FPS cap to 0 or a value you can actually hold."
      ],
      "undo": "Switch the same settings back.",
      "risk": "None.",
      "sources": [
        { "title": "Blur Busters: G-SYNC 101, optimal settings", "url": "https://blurbusters.com/gsync/gsync101-input-lag-tests-and-settings/14/", "date": "2019" },
        { "title": "NVIDIA Reflex low latency platform", "url": "https://www.nvidia.com/en-us/geforce/news/reflex-low-latency-platform/", "date": "2020" }
      ]
    },

    // ───────────────────────────── GPU driver ─────────────────────────────
    {
      "id": "gpu.driver-age",
      "title": "Graphics driver",
      "category": "gpu",
      "appliesWhen": { "path": "gpu.driverAgeDays", "exists": true },
      "current": "{gpu.name}, driver {gpu.vendorDriverVersion|default:{gpu.driverVersion}} ({gpu.driverAgeDays|days} old)",
      "outcomes": [
        { "when": { "path": "gpu.driverAgeDays", "gt": 180 }, "status": "suggest", "summary": "Your graphics driver is {gpu.driverAgeDays|days} old." },
        { "status": "good", "summary": "Your graphics driver is recent ({gpu.driverAgeDays|days} old)." }
      ],
      "recommendation": "Keep the graphics driver within a few months of the latest release.",
      "why": "Game-ready drivers fix crashes and stutter in new game updates. You don't need every release, but a driver older than about six months often misses fixes for current versions of competitive games.",
      "impact": "medium",
      "evidence": "medium",
      "steps": [
        "NVIDIA: NVIDIA App › Drivers › download the latest Game Ready driver.",
        "AMD: AMD Software: Adrenalin Edition › Driver and Software.",
        "Intel: Intel Graphics Software or intel.com/arc drivers."
      ],
      "undo": "Reinstall the older driver from the vendor's driver archive.",
      "risk": "Low. A brand-new driver occasionally has a bug; if a game breaks, roll back."
    },
    {
      "id": "gpu.ddu-every-update",
      "title": "Clean-install the driver with DDU on every update",
      "category": "gpu",
      "kind": "myth",
      "outcomes": [ { "status": "myth", "summary": "Not needed unless something is broken." } ],
      "recommendation": "Update normally. Use DDU only to fix a driver that is actually misbehaving, or when switching GPU brands.",
      "why": "A normal driver update replaces the old driver. DDU is a repair tool; running it every time adds risk (it removes settings and reboots into Safe Mode) and no one has measured a performance gain.",
      "impact": "none",
      "evidence": "low"
    },
    {
      "id": "gpu.clear-shader-cache",
      "title": "Clear the shader cache regularly for more FPS",
      "category": "gpu",
      "kind": "myth",
      "outcomes": [ { "status": "myth", "summary": "Clearing it causes stutter while the game rebuilds it." } ],
      "recommendation": "Leave the shader cache alone. Only clear it to free disk space or to fix corruption after a driver change.",
      "why": "The cache stores compiled shaders so the game doesn't compile them mid-match. Clearing it makes the first matches afterwards stutter more, not less.",
      "impact": "none",
      "evidence": "medium"
    },
    {
      "id": "gpu.nvidia-low-latency-mode",
      "title": "NVIDIA Low Latency Mode",
      "category": "gpu",
      "appliesWhen": { "path": "gpu.vendor", "eq": "nvidia" },
      "outcomes": [ { "status": "info", "summary": "Reflex in the game takes over; Low Latency Mode doesn't matter then." } ],
      "recommendation": "Turn Reflex on in the game. Low Latency Mode can stay at its default.",
      "why": "NVIDIA says that when a game has Reflex and it's on, Reflex overrides the driver's Low Latency Mode. Low Latency Mode only matters for games without Reflex.",
      "impact": "none",
      "evidence": "high",
      "steps": [ "In the game's video settings, set NVIDIA Reflex to Enabled." ],
      "sources": [ { "title": "NVIDIA Reflex low latency platform", "url": "https://www.nvidia.com/en-us/geforce/news/reflex-low-latency-platform/", "date": "2020" } ]
    },
    {
      "id": "gpu.nvidia-power-mode",
      "title": "NVIDIA power management mode",
      "category": "gpu",
      "appliesWhen": { "path": "gpu.vendor", "eq": "nvidia" },
      "outcomes": [ { "status": "info", "summary": "RigScope can't read this. Worth checking for the game's profile." } ],
      "recommendation": "Set Power management mode to Prefer maximum performance for the game (not globally).",
      "why": "At low resolutions an esports game can leave the GPU lightly loaded, and the card may drop its clocks between frames. Keeping clocks up can smooth frame times a little. The evidence is mostly anecdotal, and it raises idle power if set globally.",
      "impact": "small",
      "evidence": "low",
      "steps": [
        "NVIDIA Control Panel › Manage 3D settings › Program Settings › select the game's .exe.",
        "Power management mode › Prefer maximum performance › Apply."
      ],
      "undo": "Set it back to Normal (or Use global setting).",
      "risk": "None."
    },
    {
      "id": "gpu.driver-fps-cap",
      "title": "Frame cap in the driver",
      "category": "gpu",
      "appliesWhen": { "path": "gpu.vendor", "in": ["nvidia", "amd"] },
      "outcomes": [ { "status": "info", "summary": "Prefer the game's own cap or Reflex over a driver cap." } ],
      "recommendation": "Leave the driver's Max Frame Rate (or AMD Frame Rate Target Control) off. Cap in the game, or let Reflex cap for you with G-SYNC.",
      "why": "A cap inside the game holds frames back before input is read, which keeps latency low. A driver-level cap waits later in the pipeline and adds a little latency. Blur Busters measured this for G-SYNC setups.",
      "impact": "small",
      "evidence": "medium",
      "sources": [ { "title": "Blur Busters: G-SYNC 101, frame rate limiters", "url": "https://blurbusters.com/gsync/gsync101-input-lag-tests-and-settings/14/", "date": "2019" } ]
    },
    {
      "id": "gpu.resizable-bar",
      "title": "Resizable BAR",
      "category": "gpu",
      "appliesWhen": { "path": "gpu.resizableBarEnabled", "exists": true },
      "current": "{gpu.resizableBarEnabled|bool:On/Off}",
      "outcomes": [
        { "when": { "path": "gpu.resizableBarEnabled", "eq": false }, "status": "info", "summary": "Off. Harmless to turn on, but don't expect more FPS in esports games." },
        { "status": "good", "summary": "On." }
      ],
      "recommendation": "Optional. Turn it on if you want, but it is not an esports FPS fix.",
      "why": "NVIDIA enables Resizable BAR per game from a whitelist. No benchmark shows a gain in CS2 or other esports titles, and turning it on needs BIOS changes.",
      "impact": "none",
      "evidence": "low",
      "steps": [
        "Check Windows is installed in UEFI mode on a GPT disk first (RigScope: Firmware › Boot mode).",
        "In the BIOS: disable CSM, enable Above 4G Decoding, set Re-Size BAR Support to Auto/Enabled.",
        "Some 2020–2021 cards also need a VBIOS update from the card maker."
      ],
      "undo": "Set Re-Size BAR Support back to Disabled in the BIOS.",
      "risk": "Disabling CSM on a PC that boots in legacy/MBR mode stops Windows from starting until you turn CSM back on.",
      "sources": [ { "title": "ASUS: how to enable Resizable BAR", "url": "https://edgeup.asus.com/2021/guide-how-to-enable-resizable-bar-on-your-asus-powered-gaming-pc/", "date": "2021" } ]
    },
    {
      "id": "gpu.pcie-width",
      "title": "Graphics card slot speed",
      "category": "gpu",
      "appliesWhen": { "path": "gpu.pcieWidth", "exists": true },
      "current": "PCIe x{gpu.pcieWidth}",
      "outcomes": [
        { "when": { "path": "gpu.pcieWidth", "lt": 8 }, "status": "warn", "summary": "The graphics card is running at PCIe x{gpu.pcieWidth}." }
      ],
      "recommendation": "Put the graphics card in the top full-length slot so it runs at x16 (or x8 for cards built for x8).",
      "why": "A card in a lower slot can run at x4 or x1, which cuts bandwidth enough to cause stutter. This is usually a build mistake or a loose card.",
      "impact": "large",
      "evidence": "high",
      "steps": [ "Shut down, unplug, and move the card to the slot closest to the CPU. Make sure it clicks in fully." ],
      "risk": "Handle the card with the PC unplugged."
    },
    {
      "id": "gpu.digital-vibrance",
      "title": "Digital vibrance / saturation",
      "category": "gpu",
      "kind": "preference",
      "appliesWhen": { "path": "gpu.vendor", "in": ["nvidia", "amd"] },
      "outcomes": [ { "status": "info", "summary": "Personal preference; many players raise it to make player models stand out." } ],
      "recommendation": "Try 60–80% digital vibrance (NVIDIA) or higher saturation (AMD) if you like the look.",
      "why": "More saturated colours can make models easier to spot against grey maps. It doesn't change performance. ProSettings shows many pros using it, which is popularity, not proof.",
      "impact": "small",
      "evidence": "low",
      "steps": [ "NVIDIA Control Panel › Display › Adjust desktop color settings › Digital vibrance.", "AMD Software › Settings › Display › Custom Color › Saturation." ]
    },

    // ───────────────────────────── Windows ─────────────────────────────
    {
      "id": "windows.game-mode",
      "title": "Game Mode",
      "category": "windows",
      "current": "{windows.gameModeEnabled|bool:On/Off|default:On (Windows default)}",
      "outcomes": [
        { "when": { "path": "windows.gameModeEnabled", "eq": false }, "status": "suggest", "summary": "Game Mode is off." },
        { "status": "good", "summary": "Game Mode is on." }
      ],
      "recommendation": "Leave Game Mode on.",
      "why": "Game Mode stops Windows Update restarts and driver installs while you play, and helps Windows place game threads on the right cores. On AMD dual-CCD X3D chips and Intel hybrid chips it's part of how the game lands on the fast cores. FPS gains on its own are small.",
      "impact": "small",
      "evidence": "medium",
      "steps": [ "Settings › Gaming › Game Mode › On." ],
      "undo": "Same switch.",
      "risk": "None."
    },
    {
      "id": "windows.background-recording",
      "title": "Xbox Game Bar background recording",
      "category": "windows",
      "appliesWhen": { "path": "windows.backgroundRecording", "exists": true },
      "current": "{windows.backgroundRecording|bool:On/Off}",
      "outcomes": [
        { "when": { "path": "windows.backgroundRecording", "eq": true }, "status": "suggest", "summary": "Windows is recording the last few minutes of gameplay in the background." },
        { "status": "good", "summary": "Background recording is off." }
      ],
      "recommendation": "Turn off \"Record what happened\" unless it's the recorder you actually use. Run one recorder at most.",
      "why": "Background recording keeps the GPU's video encoder busy all the time. The cost is small (about 1–3% FPS) but it doubles up if another recorder (SteelSeries Moments, Medal, NVIDIA Instant Replay) also runs.",
      "impact": "small",
      "evidence": "medium",
      "steps": [ "Settings › Gaming › Captures › Record what happened › Off." ],
      "undo": "Same switch.",
      "risk": "None."
    },
    {
      "id": "windows.memory-integrity",
      "title": "Memory Integrity (Core isolation)",
      "category": "windows",
      "appliesWhen": { "path": "security.memoryIntegrityRunning", "exists": true },
      "current": "{security.memoryIntegrityRunning|bool:On/Off}",
      "outcomes": [
        { "when": { "path": "security.memoryIntegrityRunning", "eq": true }, "status": "good", "summary": "On. It costs a few percent FPS, but turning it off isn't worth it." },
        { "status": "info", "summary": "Off. Some anti-cheats (Riot Vanguard, FACEIT) may ask you to turn it on." }
      ],
      "recommendation": "Keep Memory Integrity on.",
      "why": "Tests on 11th-gen Intel measured about 3–7% lower average FPS with it on. That's the one sizeable Windows-level cost, but it protects against malicious kernel drivers, and Riot Vanguard may refuse to run or prompt you without it. If Docker, WSL2 or Hyper-V is installed, the hypervisor stays loaded anyway, so turning it off gets back only part of the cost.",
      "impact": "small",
      "evidence": "medium",
      "steps": [ "Windows Security › Device security › Core isolation details › Memory integrity." ],
      "undo": "Same switch, then restart.",
      "risk": "Turning it off lowers protection against bad drivers and can trigger anti-cheat restrictions.",
      "sources": [
        { "title": "Tom's Hardware: Windows 11 VBS/HVCI gaming benchmarks", "url": "https://www.tomshardware.com/news/windows-11-gaming-benchmarks-performance-vbs-hvci-security/", "date": "2021" },
        { "title": "Riot: Vanguard security requirements", "url": "https://support.riotgames.com/en-us/riot/performance/vanguard-security-requirements", "date": "2026" }
      ]
    },
    {
      "id": "windows.hags",
      "title": "Hardware-accelerated GPU scheduling",
      "category": "windows",
      "kind": "preference",
      "current": "{windows.hagsEnabled|bool:On/Off|default:Windows default}",
      "outcomes": [ { "status": "info", "summary": "No consistent gain either way in tests; leave it unless you want to A/B test." } ],
      "recommendation": "Leave it at whatever it is. Test both only if you measure frame times.",
      "why": "PCWorld's tests found no consistent FPS difference. Reports on latency with Reflex conflict. It's required for frame generation (RTX 40 and newer), which competitive players usually don't use.",
      "impact": "none",
      "evidence": "low",
      "steps": [ "Settings › System › Display › Graphics › Change default graphics settings › Hardware-accelerated GPU scheduling. Needs a restart." ],
      "sources": [ { "title": "PCWorld: should you enable HAGS?", "url": "https://www.pcworld.com/article/2339130/should-you-enable-hardware-accelerated-gpu-scheduling-in-windows-11.html", "date": "2024" } ]
    },
    {
      "id": "windows.windowed-optimizations",
      "title": "Optimizations for windowed games",
      "category": "windows",
      "current": "{windows.windowedOptimizations|bool:On/Off|default:Windows default}",
      "outcomes": [
        { "when": { "path": "windows.windowedOptimizations", "eq": false }, "status": "suggest", "summary": "Off. Turn it on if you play in borderless/windowed mode." },
        { "status": "good", "summary": "On (or default)." }
      ],
      "recommendation": "Leave it on.",
      "why": "It switches older DirectX 10/11 games in borderless or windowed mode to a lower-latency presentation model. It does nothing in exclusive fullscreen and doesn't hurt.",
      "impact": "small",
      "evidence": "high",
      "steps": [ "Settings › System › Display › Graphics › Change default graphics settings › Optimizations for windowed games." ],
      "sources": [ { "title": "Microsoft DirectX blog: updates in graphics and gaming", "url": "https://devblogs.microsoft.com/directx/updates-in-graphics-and-gaming/", "date": "2022" } ]
    },
    {
      "id": "windows.power-plan",
      "title": "Power plan",
      "category": "windows",
      "current": "{windows.powerPlanName|default:Unknown}",
      "outcomes": [
        { "when": { "path": "windows.powerPlanIsPowerSaver", "eq": true }, "status": "warn", "summary": "Power saver limits CPU speed in games." },
        { "when": { "all": [ { "path": "windows.powerPlanIsBalanced", "eq": true }, { "path": "firmware.isLaptop", "eq": false } ] }, "status": "info", "summary": "Balanced is fine. High performance can avoid small clock ramp-up hitches." },
        { "status": "good", "summary": "{windows.powerPlanName}." }
      ],
      "recommendation": "Balanced or High performance on a desktop. Avoid Power saver.",
      "why": "Modern CPUs boost well on Balanced. High performance keeps clocks and cores ready, which can remove small hitches at the cost of idle power. Imported \"ultimate\" plans from tweak scripts are fine, but if you're unsure what they change, use the built-in High performance plan.",
      "impact": "small",
      "evidence": "low",
      "steps": [ "Control Panel › Power Options (or run powercfg.cpl) › choose High performance or Balanced." ],
      "undo": "Pick the previous plan.",
      "risk": "Higher idle power use on High performance."
    },
    {
      "id": "windows.mouse-acceleration",
      "title": "Enhance pointer precision",
      "category": "windows",
      "current": "{windows.mouseAcceleration|bool:On/Off}",
      "outcomes": [
        { "when": { "path": "windows.mouseAcceleration", "eq": true }, "status": "info", "summary": "On. Competitive games use raw input, so it doesn't affect aim, only the desktop." },
        { "status": "good", "summary": "Off." }
      ],
      "recommendation": "Turn it off for a consistent feel between desktop and game.",
      "why": "CS2, VALORANT, Apex and other modern shooters read raw mouse input and ignore Windows acceleration. It only changes how the cursor feels in menus and on the desktop.",
      "impact": "none",
      "evidence": "high",
      "steps": [ "Settings › Bluetooth & devices › Mouse › Additional mouse settings › Pointer Options › untick Enhance pointer precision." ]
    },
    {
      "id": "windows.timer-resolution",
      "title": "Timer resolution tools and GlobalTimerResolutionRequests",
      "category": "windows",
      "kind": "myth",
      "outcomes": [ { "status": "myth", "summary": "Games set their own timer; system-wide tools add nothing." } ],
      "recommendation": "Skip timer resolution tools.",
      "why": "Since Windows 10 version 2004 timer resolution is per process. Games already request what they need, so a background tool forcing 0.5 ms doesn't change the game.",
      "impact": "none",
      "evidence": "low"
    },
    {
      "id": "windows.nagle",
      "title": "Disable Nagle's algorithm (TcpNoDelay, TcpAckFrequency)",
      "category": "network",
      "kind": "myth",
      "outcomes": [ { "status": "myth", "summary": "Only affects TCP; game traffic is UDP." } ],
      "recommendation": "Skip it.",
      "why": "Nagle's algorithm batches small TCP packets. Competitive shooters send game traffic over UDP, which Nagle never touches.",
      "impact": "none",
      "evidence": "high",
      "sources": [ { "title": "Microsoft: Socket.NoDelay (TCP only)", "url": "https://learn.microsoft.com/en-us/dotnet/api/system.net.sockets.socket.nodelay", "date": "" } ]
    },
    {
      "id": "windows.network-throttling",
      "title": "NetworkThrottlingIndex and SystemResponsiveness tweaks",
      "category": "windows",
      "kind": "myth",
      "outcomes": [ { "status": "myth", "summary": "These don't apply to how games send traffic." } ],
      "recommendation": "Skip them.",
      "why": "NetworkThrottlingIndex only throttles above about 10 packets per millisecond while media plays; games send 64–128 packets per second. SystemResponsiveness only affects threads registered with the Windows multimedia scheduler.",
      "impact": "none",
      "evidence": "medium"
    },
    {
      "id": "windows.priority-separation",
      "title": "Win32PrioritySeparation and \"-high\" priority",
      "category": "windows",
      "kind": "myth",
      "outcomes": [ { "status": "myth", "summary": "Windows already favours the game in the foreground." } ],
      "recommendation": "Skip it.",
      "why": "The default already boosts the foreground app. Forcing high priority can starve audio and input threads, which makes things worse, and no one has measured a gain.",
      "impact": "none",
      "evidence": "low"
    },
    {
      "id": "windows.debloat",
      "title": "Debloat scripts and disabling SysMain/Search",
      "category": "windows",
      "kind": "myth",
      "outcomes": [ { "status": "myth", "summary": "No measured FPS gain on an SSD with 16 GB or more." } ],
      "recommendation": "Skip FPS \"debloat packs\". Remove apps you don't use the normal way instead.",
      "why": "SysMain and Search use almost nothing on a modern SSD system. Aggressive scripts can break Windows Update, the Store and anti-cheat, and are hard to undo.",
      "impact": "none",
      "evidence": "low"
    },
    {
      "id": "windows.fso",
      "title": "Disable fullscreen optimizations on the game .exe",
      "category": "windows",
      "kind": "myth",
      "outcomes": [ { "status": "myth", "summary": "No measured benefit; can break alt-tab." } ],
      "recommendation": "Leave the compatibility checkbox alone unless a game doesn't run in a flip present mode.",
      "why": "Modern Windows already gives fullscreen games an independent flip path with the same latency as old exclusive fullscreen. A tool like PresentMon shows the present mode if you want to check.",
      "impact": "none",
      "evidence": "low"
    },

    // ───────────────────────────── Background apps ─────────────────────────────
    {
      "id": "apps.peripheral-suites",
      "title": "Peripheral and RGB software",
      "category": "apps",
      "appliesWhen": { "path": "apps[category=rgb]", "countGte": 1 },
      "current": "{apps[category=rgb].name|join}",
      "outcomes": [
        { "when": { "path": "apps[category=rgb,running=true]", "countGte": 2 }, "status": "suggest",
          "summary": "{apps[category=rgb,running=true]|count} peripheral suites are running: {apps[category=rgb,running=true].name|join}." },
        { "when": { "path": "apps[category=rgb,startsWithWindows=true]", "countGte": 2 }, "status": "suggest",
          "summary": "{apps[category=rgb,startsWithWindows=true]|count} peripheral suites start with Windows." },
        { "status": "good", "summary": "Only one peripheral suite is active." }
      ],
      "recommendation": "Save your mouse, keyboard and headset profiles to the devices' onboard memory, then keep one suite running (or none).",
      "why": "RGB and peripheral suites poll hardware and animate lighting in the background. Many users report CPU spikes and stutter from iCUE, G HUB and others; nobody has benchmarked several together. Most devices keep DPI, polling rate and lighting without the software once saved to onboard memory.",
      "impact": "medium",
      "evidence": "low",
      "steps": [
        "In each suite, save your profile to the device (look for Onboard memory / Save to device).",
