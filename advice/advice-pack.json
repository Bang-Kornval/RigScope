      "category": "inGame",
      "games": ["cs2"],
      "appliesWhen": { "path": "cs2.primary.video.mat_vsync", "exists": true },
      "current": "{cs2.primary.video.mat_vsync|map:0=Off;1=On}",
      "outcomes": [
        { "when": { "path": "cs2.primary.video.mat_vsync", "ne": "0" }, "status": "suggest", "summary": "V-Sync is on in the game." },
        { "status": "good", "summary": "V-Sync is off in the game." }
      ],
      "recommendation": "Keep V-Sync off in CS2. If you use G-SYNC/FreeSync, turn V-Sync on in the graphics driver instead.",
      "why": "In-game V-Sync without variable refresh adds a lot of input lag. With G-SYNC, the recommended setup is V-Sync in the driver plus Reflex, which caps FPS just below the refresh rate.",
      "impact": "large",
      "evidence": "high",
      "steps": [ "CS2 › Settings › Video › Advanced Video › Wait for Vertical Sync › Disabled." ],
      "sources": [ { "title": "Blur Busters: G-SYNC 101", "url": "https://blurbusters.com/gsync/gsync101-input-lag-tests-and-settings/14/", "date": "2019" } ]
    },
    {
      "id": "cs2.fps-cap",
      "title": "FPS cap (fps_max)",
      "category": "inGame",
      "games": ["cs2"],
      "kind": "preference",
      "appliesWhen": { "path": "cs2.primary", "exists": true },
      "current": "{cs2.primary.fpsMax|map:0=Uncapped (0)|default:Game default (400)} — set in {cs2.primary.fpsMaxSource}",
      "outcomes": [ { "status": "info", "summary": "Match the cap to your sync choice." } ],
      "recommendation": "With G-SYNC + Reflex: fps_max 0 and let Reflex cap. Without sync: 0 (uncapped) or a cap you can hold in heavy fights.",
      "why": "A cap you can't hold makes frame times uneven. Uncapped is fine if your 1% lows stay well above your refresh rate. With G-SYNC, Reflex automatically caps a few FPS below the refresh rate (about 158 at 165 Hz) to stay inside the variable refresh range.",
      "impact": "medium",
      "evidence": "medium",
      "steps": [ "Set it in the console (fps_max 0), in Steam launch options (+fps_max 0) or in CS2 › Settings › Video › Advanced Video › Maximum FPS." ]
    },
    {
      "id": "cs2.display-mode",
      "title": "Display mode in CS2",
      "category": "inGame",
      "games": ["cs2"],
      "appliesWhen": { "path": "cs2.primary.video.fullscreen", "exists": true },
      "current": "{cs2.primary.video.fullscreen|map:1=Fullscreen;0=Windowed / fullscreen windowed}",
      "outcomes": [
        { "when": { "path": "cs2.primary.video.fullscreen", "eq": "1" }, "status": "good", "summary": "Exclusive fullscreen." },
        { "status": "suggest", "summary": "CS2 runs windowed or fullscreen windowed." }
      ],
      "recommendation": "Use Fullscreen.",
      "why": "Fullscreen is never slower than borderless in CS2 and avoids the desktop compositor adding latency. Borderless is mainly useful if you alt-tab a lot.",
      "impact": "small",
      "evidence": "medium",
      "steps": [ "CS2 › Settings › Video › Display Mode › Fullscreen." ]
    },
    {
      "id": "cs2.refresh-rate",
      "title": "Refresh rate set in CS2",
      "category": "inGame",
      "games": ["cs2"],
      "appliesWhen": { "all": [ { "path": "cs2.primary.configuredRefreshHz", "exists": true }, { "path": "display.maxRefreshHz", "gt": 0 } ] },
