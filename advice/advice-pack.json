      "outcomes": [
        { "when": { "path": "cs2.primary.configuredRefreshHz", "lt": "{display.maxRefreshHz}" }, "status": "warn", "summary": "CS2 is set to {cs2.primary.configuredRefreshHz} Hz." },
        { "status": "good", "summary": "CS2 uses {cs2.primary.configuredRefreshHz} Hz." }
      ],
      "recommendation": "Pick your monitor's highest refresh rate in CS2's video settings.",
      "why": "In fullscreen CS2 switches the monitor to the rate saved in its own config, which can be lower than Windows' setting after a monitor change.",
      "impact": "large",
      "evidence": "high",
      "steps": [ "CS2 › Settings › Video › Refresh Rate › highest value." ]
    },
