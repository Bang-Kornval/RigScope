    {
      "id": "cs2.net-buffer",
      "title": "Buffering to smooth over packet loss",
      "category": "inGame",
      "games": ["cs2"],
      "appliesWhen": { "path": "cs2.primary", "exists": true },
      "current": "{cs2.primary.netBufferTicks|map:0=None;1=1 packet;2=2 packets|default:None (default)}",
      "outcomes": [
        { "when": { "all": [ { "path": "cs2.primary.netBufferTicks", "gt": 0 }, { "path": "network[isDefaultRoute=true].kind", "eq": "ethernet" } ] },
          "status": "suggest", "summary": "Buffering is on while you're on a wired connection." },
        { "when": { "path": "cs2.primary.netBufferTicks", "gt": 0 }, "status": "info", "summary": "Buffering is on. That's reasonable on Wi-Fi with packet loss." },
        { "status": "good", "summary": "No buffering." }
      ],
      "recommendation": "Set it to None on a clean wired connection.",
      "why": "Each buffered packet adds about one tick (around 16 ms) of delay. It only helps if your connection actually drops packets; check CS2's telemetry (Settings › Game › Telemetry) for packet loss first.",
      "impact": "medium",
      "evidence": "medium",
      "steps": [ "CS2 › Settings › Game › Game › Buffering to smooth over packet loss › None." ]
    },
