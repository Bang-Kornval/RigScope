    {
      "id": "cs2.anti-aliasing",
      "title": "Anti-aliasing",
      "category": "inGame",
      "games": ["cs2"],
      "kind": "preference",
      "appliesWhen": { "path": "cs2.primary.video.msaa_samples", "exists": true },
      "current": "{cs2.primary.video.msaa_samples|map:0=None or CMAA2;2=2x MSAA;4=4x MSAA;8=8x MSAA}",
      "outcomes": [
        { "when": { "path": "cs2.primary.video.msaa_samples", "eq": "8" }, "status": "suggest", "summary": "8x MSAA costs a lot of FPS for little visible gain over 4x." },
        { "status": "info", "summary": "A trade-off between sharp edges and FPS." }
      ],
      "recommendation": "4x MSAA for clean edges on distant players, or 2x / CMAA2 if you need FPS. Compare your 1% lows.",
      "why": "MSAA is usually the biggest GPU cost in CS2's settings: 4x costs roughly 10–20%. Smooth edges make far-away heads easier to read; CMAA2 is cheaper but softer.",
      "impact": "medium",
      "evidence": "medium",
      "steps": [ "CS2 › Settings › Video › Advanced Video › Multisampling Anti-Aliasing Mode." ]
    },
