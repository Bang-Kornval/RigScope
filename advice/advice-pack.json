    {
      "id": "cs2.dynamic-shadows",
      "title": "Dynamic shadows",
      "category": "inGame",
      "games": ["cs2"],
      "appliesWhen": { "path": "cs2.primary.video.videocfg_dynamic_shadows", "exists": true },
      "current": "{cs2.primary.video.videocfg_dynamic_shadows|map:1=All (likely);0=Sun only (likely)}",
      "outcomes": [
        { "when": { "path": "cs2.primary.video.videocfg_dynamic_shadows", "eq": "0" }, "status": "suggest", "summary": "Probably set to Sun only." },
