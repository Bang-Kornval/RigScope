<Application x:Class="RigScope.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:RigScope.App.Converters"
             ThemeMode="System">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Status colours: mid-tone so white text reads on them in both light and dark themes. -->
            <SolidColorBrush x:Key="StatusWarnBrush" Color="#D2453C" />
            <SolidColorBrush x:Key="StatusSuggestBrush" Color="#C47A0A" />
            <SolidColorBrush x:Key="StatusGoodBrush" Color="#2E8B6A" />
            <SolidColorBrush x:Key="StatusInfoBrush" Color="#4E6E8E" />
            <SolidColorBrush x:Key="StatusMythBrush" Color="#7A6A92" />
            <SolidColorBrush x:Key="StatusUnknownBrush" Color="#7C7C7C" />
            <SolidColorBrush x:Key="AccentScopeBrush" Color="#2ECCAA" />

            <!-- Treemap palette: distinguishable hues at similar lightness. -->
            <x:Array x:Key="TreemapPalette" Type="Color">
                <Color>#1D8A6F</Color>
                <Color>#3A6FB5</Color>
                <Color>#8A5BB8</Color>
                <Color>#C0712E</Color>
                <Color>#4F8C3A</Color>
                <Color>#B5486B</Color>
                <Color>#2F8E9E</Color>
                <Color>#8A7A2E</Color>
            </x:Array>

            <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

            <conv:StatusToBrushConverter x:Key="StatusBrush" />
            <conv:BytesConverter x:Key="Bytes" />
            <conv:BoolToVisibilityConverter x:Key="Visible" />
            <conv:BoolToVisibilityConverter x:Key="Collapsed" Invert="True" />
            <conv:NullToVisibilityConverter x:Key="NotNullVisible" />
            <conv:StringToVisibilityConverter x:Key="TextVisible" />
            <conv:ZeroToVisibilityConverter x:Key="ZeroVisible" />
            <conv:InverseBoolConverter x:Key="Not" />
            <conv:CleanupTagTextConverter x:Key="CleanupTagText" />
            <conv:EnumEqualsConverter x:Key="EnumEquals" />

            <Style x:Key="PageTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="26" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>
            <Style x:Key="PageSubtitle" TargetType="TextBlock">
                <Setter Property="Opacity" Value="0.75" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,0,0,18" />
            </Style>
            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>
            <Style x:Key="Label" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Opacity" Value="0.7" />
                <Setter Property="Margin" Value="0,10,0,2" />
            </Style>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16" />
            </Style>
            <Style x:Key="Pill" TargetType="Border">
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="8,2" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>
            <Style x:Key="PillText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
