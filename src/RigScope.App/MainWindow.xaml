<Window x:Class="RigScope.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RigScope.App.ViewModels"
        xmlns:views="clr-namespace:RigScope.App.Views"
        Title="RigScope" Width="1280" Height="820" MinWidth="900" MinHeight="600"
        Icon="pack://application:,,,/Assets/RigScope.ico"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:OverviewViewModel}"><views:OverviewView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:CheckViewModel}"><views:CheckView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:PeripheralsViewModel}"><views:PeripheralsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:StorageViewModel}"><views:StorageView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:MeasureViewModel}"><views:MeasureView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportViewModel}"><views:ReportView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView /></DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Navigation -->
        <DockPanel Grid.Column="0" Margin="12,16,8,12">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,20">
                <Image Source="pack://application:,,,/Assets/RigScope.ico" Width="28" Height="28" />
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="RigScope" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="Competitive FPS check" FontSize="11" Opacity="0.7" />
                </StackPanel>
            </StackPanel>

            <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="12" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Read-only" FontWeight="SemiBold" Foreground="{StaticResource StatusGoodBrush}" />
                    <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.8" Margin="0,4,0,8"
                               Text="RigScope only reads settings. It never changes, deletes or tweaks anything on your PC." />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Command="{Binding OpenSettingsCommand}" Padding="8,6" Margin="8,0,0,0" VerticalAlignment="Bottom"
                                ToolTip="Settings: check again, updates and what's new" AutomationProperties.Name="Settings">
                            <Grid>
                                <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" />
                                <!-- Dot when the startup check found a newer version. -->
                                <Ellipse Width="8" Height="8" Fill="{StaticResource AccentScopeBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,-5,0"
                                         Visibility="{Binding Settings.Available, Converter={StaticResource NotNullVisible}}" />
                            </Grid>
                        </Button>
                        <StackPanel VerticalAlignment="Bottom">
                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource StatusGoodBrush}" Margin="0,0,0,2"
                                       Text="{Binding Settings.Available.Version, StringFormat='Update available: {0}'}"
                                       Visibility="{Binding Settings.Available, Converter={StaticResource NotNullVisible}}" />
                            <TextBlock Text="{Binding StatusText}" FontSize="11" Opacity="0.7" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}" Background="Transparent" BorderThickness="0"
                     AutomationProperties.Name="Pages">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="4,6">
                            <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Title}" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Page -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" Margin="8,16,20,16" Focusable="False" />

        <!-- First load -->
        <Grid Grid.ColumnSpan="2" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
              Visibility="{Binding IsLoading, Converter={StaticResource Visible}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="360">
                <Image Source="pack://application:,,,/Assets/RigScope.ico" Width="56" Height="56" />
                <TextBlock Text="Checking your PC" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,6" />
                <TextBlock Text="{Binding LoadingText}" HorizontalAlignment="Center" Opacity="0.75" />
                <ProgressBar IsIndeterminate="True" Margin="0,16,0,0" Height="4" />
                <TextBlock Text="RigScope only reads. Nothing on your PC is changed." HorizontalAlignment="Center" FontSize="12" Opacity="0.6" Margin="0,16,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
