<UserControl x:Class="RigScope.App.Views.CheckView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Competitive check" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="What's worth changing for low latency and stable frame times, what's already right, and which popular tweaks to skip." />
            <WrapPanel Margin="0,0,0,12">
                <StackPanel Margin="0,0,24,8">
                    <TextBlock Text="Game" Style="{StaticResource Label}" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}" DisplayMemberPath="Display" MinWidth="240"
                              AutomationProperties.Name="Game" />
                </StackPanel>
                <StackPanel Margin="0,0,0,8">
                    <TextBlock Text="Show" Style="{StaticResource Label}" Margin="0,0,0,4" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="Worth doing" Margin="0,0,16,0" IsChecked="{Binding Filter, Converter={StaticResource EnumEquals}, ConverterParameter=WorthDoing}" />
                        <RadioButton Content="Already good" Margin="0,0,16,0" IsChecked="{Binding Filter, Converter={StaticResource EnumEquals}, ConverterParameter=Good}" />
                        <RadioButton Content="Preferences" Margin="0,0,16,0" IsChecked="{Binding Filter, Converter={StaticResource EnumEquals}, ConverterParameter=Preferences}" />
                        <RadioButton Content="Myths" Margin="0,0,16,0" IsChecked="{Binding Filter, Converter={StaticResource EnumEquals}, ConverterParameter=Myths}" />
                        <RadioButton Content="Everything" IsChecked="{Binding Filter, Converter={StaticResource EnumEquals}, ConverterParameter=All}" />
                    </StackPanel>
                </StackPanel>
            </WrapPanel>
            <TextBlock Text="{Binding Counts}" Opacity="0.7" Margin="0,0,0,10" />
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" MinWidth="300" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="6*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!-- List -->
            <Border Style="{StaticResource Card}" Padding="4">
                <Grid>
                    <ListBox HorizontalContentAlignment="Stretch" ItemsSource="{Binding ItemsView}" SelectedItem="{Binding Selected}" BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Findings"
                             VirtualizingPanel.IsVirtualizingWhenGrouping="True">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" Opacity="0.7" Margin="10,12,0,4" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Fill="{Binding Status, Converter={StaticResource StatusBrush}}" RadiusX="2" RadiusY="2" />
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontSize="12.5" Opacity="0.8" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="{Binding EmptyText}" TextWrapping="Wrap" Margin="16" Opacity="0.75"
                               Visibility="{Binding EmptyText, Converter={StaticResource TextVisible}}" />
                </Grid>
            </Border>

            <!-- Detail -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,18" DataContext="{Binding Selected}" Visibility="{Binding Converter={StaticResource NotNullVisible}}">
                        <WrapPanel>
                            <Border Style="{StaticResource Pill}" Background="{Binding Status, Converter={StaticResource StatusBrush}}" Margin="0,0,8,6">
                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource PillText}" />
                            </Border>
                            <Border Style="{StaticResource Pill}" Background="{DynamicResource SubtleFillColorSecondaryBrush}" Margin="0,0,8,6">
                                <TextBlock Text="{Binding Impact}" FontSize="11" />
                            </Border>
                            <Border Style="{StaticResource Pill}" Background="{DynamicResource SubtleFillColorSecondaryBrush}" Margin="0,0,8,6">
                                <TextBlock Text="{Binding Evidence}" FontSize="11" />
                            </Border>
                        </WrapPanel>
                        <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,6" />
                        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontSize="14" />

                        <StackPanel Visibility="{Binding Current, Converter={StaticResource TextVisible}}">
                            <TextBlock Text="ON THIS PC" Style="{StaticResource Label}" Margin="0,16,0,2" />
                            <TextBlock Text="{Binding Current}" TextWrapping="Wrap" FontFamily="{StaticResource MonoFont}" FontSize="12.5" />
                        </StackPanel>

                        <TextBlock Text="RECOMMENDATION" Style="{StaticResource Label}" Margin="0,16,0,2" />
                        <TextBlock Text="{Binding Recommendation}" TextWrapping="Wrap" FontWeight="SemiBold" />

                        <TextBlock Text="WHY" Style="{StaticResource Label}" Margin="0,16,0,2" />
                        <TextBlock Text="{Binding Why}" TextWrapping="Wrap" LineHeight="20" />

                        <StackPanel Visibility="{Binding HasSteps, Converter={StaticResource Visible}}">
                            <TextBlock Text="HOW TO CHANGE IT YOURSELF" Style="{StaticResource Label}" Margin="0,16,0,4" />
                            <ItemsControl ItemsSource="{Binding Steps}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="22" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Number}" Opacity="0.6" />
                                            <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Visibility="{Binding Undo, Converter={StaticResource TextVisible}}">
                            <TextBlock Text="TO UNDO" Style="{StaticResource Label}" Margin="0,16,0,2" />
                            <TextBlock Text="{Binding Undo}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Visibility="{Binding Risk, Converter={StaticResource TextVisible}}">
                            <TextBlock Text="RISK" Style="{StaticResource Label}" Margin="0,16,0,2" />
                            <TextBlock Text="{Binding Risk}" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding HasSources, Converter={StaticResource Visible}}">
                            <TextBlock Text="SOURCES" Style="{StaticResource Label}" Margin="0,16,0,4" />
                            <ItemsControl ItemsSource="{Binding Sources}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="0,2" TextWrapping="Wrap">
                                            <Hyperlink Command="{Binding DataContext.OpenSourceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                       ToolTip="{Binding Url}">
                                                <Run Text="{Binding Title, Mode=OneWay}" />
                                            </Hyperlink>
                                            <Run Text="{Binding Date, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
