<UserControl x:Class="RigScope.App.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
        <StackPanel>
            <TextBlock Text="Overview" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{Binding Headline}" Style="{StaticResource PageSubtitle}" FontSize="15" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <!-- Top findings -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}">
                            <Run Text="Your top changes for " /><Run Text="{Binding GameName, Mode=OneWay}" />
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding Top}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource Pill}" Background="{Binding Status, Converter={StaticResource StatusBrush}}" Margin="0,2,0,0">
                                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource PillText}" />
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Opacity="0.8" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Nothing urgent. Open the competitive check to see everything RigScope looked at." TextWrapping="Wrap" Opacity="0.75"
                                   Visibility="{Binding Top.Count, Converter={StaticResource ZeroVisible}}" />
                        <Button Content="Open the full competitive check" Command="{Binding ShowCheckCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>

                <!-- Hardware -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="This PC" Style="{StaticResource SectionTitle}" />
                        <ItemsControl ItemsSource="{Binding Specs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="{Binding Label}" FontSize="11" Opacity="0.65" />
                                        <TextBlock Text="{Binding Value}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Note}" TextWrapping="Wrap" FontSize="12" Opacity="0.75"
                                                   Visibility="{Binding Note, Converter={StaticResource TextVisible}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Drives" Style="{StaticResource SectionTitle}" />
                        <ItemsControl ItemsSource="{Binding Drives}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,4,0,10">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Opacity="0.75" FontFamily="{StaticResource MonoFont}" FontSize="12">
                                                <Run Text="{Binding FreeBytes, Converter={StaticResource Bytes}, Mode=OneWay}" /><Run Text=" free of " /><Run Text="{Binding TotalBytes, Converter={StaticResource Bytes}, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock FontWeight="SemiBold">
                                                <Run Text="{Binding Letter, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding Label, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding MediaType, Mode=OneWay}" FontWeight="Normal" />
                                            </TextBlock>
                                        </DockPanel>
                                        <ProgressBar Height="8" Margin="0,6,0,0" Maximum="100" Value="{Binding FreePercent, Mode=OneWay}" Foreground="{StaticResource AccentScopeBrush}"
                                                     FlowDirection="RightToLeft" ToolTip="Free space (filled part)" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="See what's taking space" Command="{Binding ShowStorageCommand}" HorizontalAlignment="Left" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Competitive games found" Style="{StaticResource SectionTitle}" />
                        <ItemsControl ItemsSource="{Binding Games}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,3">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Launcher}" Opacity="0.65" FontSize="12" />
                                        <TextBlock Text="{Binding Name}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="None of the supported games were found. The PC checks still apply." TextWrapping="Wrap" Opacity="0.75"
                                   Visibility="{Binding Games.Count, Converter={StaticResource ZeroVisible}}" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
