<UserControl x:Class="RigScope.App.Views.StorageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:RigScope.App.Controls">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Storage" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="See what fills your drives. RigScope only measures; use Explorer or the app that owns a file to remove it." />
            <WrapPanel Margin="0,0,0,12">
                <ComboBox ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive}" DisplayMemberPath="Display" MinWidth="320" Margin="0,0,12,6"
                          AutomationProperties.Name="Drive" IsEnabled="{Binding IsScanning, Converter={StaticResource Not}}" />
                <Button Content="Scan drive" Command="{Binding ScanCommand}" Margin="0,0,12,6" Style="{DynamicResource AccentButtonStyle}"
                        Visibility="{Binding IsScanning, Converter={StaticResource Collapsed}}" />
                <Button Content="Stop" Command="{Binding CancelCommand}" Margin="0,0,12,6"
                        Visibility="{Binding IsScanning, Converter={StaticResource Visible}}" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6"
                            Visibility="{Binding IsScanning, Converter={StaticResource Visible}}">
                    <ProgressBar IsIndeterminate="True" Width="120" Height="4" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding ProgressText}" FontFamily="{StaticResource MonoFont}" FontSize="12" />
                </StackPanel>
            </WrapPanel>
        </StackPanel>

        <!-- Before the first scan -->
        <Border Style="{StaticResource Card}" VerticalAlignment="Top" Visibility="{Binding HasScan, Converter={StaticResource Collapsed}}">
            <StackPanel>
                <TextBlock Text="Pick a drive and press Scan drive." Style="{StaticResource SectionTitle}" />
                <TextBlock TextWrapping="Wrap" Opacity="0.8"
                           Text="A full scan of a 1 TB SSD takes about 15 seconds. RigScope reads folder sizes only. It saves a small summary in your AppData folder so the next scan can show what changed." />
                <TextBlock Text="{Binding ProgressText}" Margin="0,8,0,0" Opacity="0.7" Visibility="{Binding ProgressText, Converter={StaticResource TextVisible}}" />
            </StackPanel>
        </Border>

        <Grid Visibility="{Binding HasScan, Converter={StaticResource Visible}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="3*" MinHeight="260" />
                <RowDefinition Height="12" />
                <RowDefinition Height="2*" MinHeight="200" />
            </Grid.RowDefinitions>

            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,8" />

            <!-- Treemap + folder list -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="2*" MinWidth="280" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Padding="10">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Button DockPanel.Dock="Left" Command="{Binding UpCommand}" ToolTip="Up one folder" Padding="8,2" Margin="0,0,8,0"
                                    AutomationProperties.Name="Up one folder">
                                <TextBlock Text="&#xE74A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                            </Button>
                            <ItemsControl ItemsSource="{Binding Breadcrumb}" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock>
                                                <Hyperlink Command="{Binding DataContext.GoToCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                    <Run Text="{Binding Name, Mode=OneWay}" />
                                                </Hyperlink>
                                            </TextBlock>
                                            <TextBlock Text=" › " Opacity="0.5" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>
                        <controls:TreemapControl Node="{Binding Current}" OpenCommand="{Binding OpenCommand}" ClipToBounds="True"
                                                 AutomationProperties.Name="Folder size map" />
                    </DockPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="4">
                    <ListBox HorizontalContentAlignment="Stretch" x:Name="FolderList" ItemsSource="{Binding Rows}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="Folders" ToolTip="Double-click or press Enter to open. Backspace goes up."
                             MouseDoubleClick="FolderList_MouseDoubleClick" PreviewKeyDown="FolderList_KeyDown">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,3">
                                    <Grid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Show in Explorer" Command="{Binding PlacementTarget.Tag.ShowInExplorerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding FullPath}" />
                                            <MenuItem Header="Copy path" Command="{Binding PlacementTarget.Tag.CopyPathCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding FullPath}" />
                                        </ContextMenu>
                                    </Grid.ContextMenu>
                                    <Grid.Tag>
                                        <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                    </Grid.Tag>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{Binding Size, Converter={StaticResource Bytes}}" FontFamily="{StaticResource MonoFont}" FontSize="12.5" Margin="8,0,0,0" />
                                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Meta}" FontSize="11.5" Opacity="0.65" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>

            <!-- Detail tabs -->
            <TabControl Grid.Row="3">
                <TabItem Header="Where to look first">
                    <ListBox HorizontalContentAlignment="Stretch" ItemsSource="{Binding Notes}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="104" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource Pill}" Background="{Binding Tag, Converter={StaticResource StatusBrush}}" Margin="0,2,0,0">
                                        <TextBlock Style="{StaticResource PillText}" Text="{Binding Tag, Converter={StaticResource CleanupTagText}}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Body}" TextWrapping="Wrap" FontSize="12.5" Opacity="0.8" />
                                        <TextBlock Visibility="{Binding Path, Converter={StaticResource TextVisible}}" Margin="0,2,0,0" FontSize="12">
                                            <Hyperlink Command="{Binding DataContext.ShowInExplorerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Path}">Show in Explorer</Hyperlink>
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Bytes, Converter={StaticResource Bytes}}" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </TabItem>
                <TabItem Header="Changes since last scan">
                    <DockPanel Margin="4">
                        <TextBlock DockPanel.Dock="Top" Text="{Binding ChangesSummary}" TextWrapping="Wrap" Margin="0,4,0,8" FontWeight="SemiBold" />
                        <ListBox HorizontalContentAlignment="Stretch" ItemsSource="{Binding Changes}" BorderThickness="0" Background="Transparent">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,2">
                                        <TextBlock DockPanel.Dock="Left" Width="110" Text="{Binding DeltaText}" FontFamily="{StaticResource MonoFont}" TextAlignment="Right" Margin="0,0,12,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource StatusSuggestBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Freed}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource StatusGoodBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Path}" FontFamily="{StaticResource MonoFont}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </TabItem>
                <TabItem Header="Largest files">
                    <DockPanel Margin="4">
                        <TextBox DockPanel.Dock="Top" Text="{Binding FileFilter, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8" MaxWidth="360" HorizontalAlignment="Left" MinWidth="280"
                                 AutomationProperties.Name="Filter files" ToolTip="Filter by path or file type" />
                        <ListView x:Name="FileList" ItemsSource="{Binding Files}" BorderThickness="0" MouseDoubleClick="FileList_MouseDoubleClick">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Size" Width="90">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate><TextBlock Text="{Binding Size, Converter={StaticResource Bytes}}" FontFamily="{StaticResource MonoFont}" /></DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Modified" Width="100" DisplayMemberBinding="{Binding Modified, StringFormat=yyyy-MM-dd}" />
                                    <GridViewColumn Header="Path" Width="900">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Path}" FontFamily="{StaticResource MonoFont}" FontSize="12" ToolTip="Double-click to show in Explorer" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </DockPanel>
                </TabItem>
                <TabItem Header="By file type">
                    <ItemsControl ItemsSource="{Binding Extensions}" Margin="8">
                        <ItemsControl.Template>
                            <ControlTemplate><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter /></ScrollViewer></ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Extension}" FontFamily="{StaticResource MonoFont}" />
                                    <ProgressBar Grid.Column="1" Maximum="100" Value="{Binding Share, Mode=OneWay}" Height="8" Foreground="{StaticResource AccentScopeBrush}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Bytes, Converter={StaticResource Bytes}}" FontFamily="{StaticResource MonoFont}" TextAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</UserControl>
